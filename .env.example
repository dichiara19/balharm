# Bal'harm — environment variables
#
# In production these are configured in the Cloudflare Pages dashboard:
#   Pages → balharm → Settings → Environment variables → Production
# Copy this file to `.env` for local `wrangler pages dev` runs.

# Google Photorealistic 3D Tiles API key.
# Restrict it in Google Cloud Console → APIs & Services → Credentials to
# allow only HTTP referrer = your production domain (e.g. balharm.pages.dev,
# balharm.com). Keep a separate, unrestricted key for local development.
GOOGLE_3DTILES_KEY=replace-me-with-your-key
